{
  "schema_version": "coffee-schema-1",
  "category": "coffee",
  "market": "uk",
  "status": "example_profile_pending_evidence_review",
  "attribute_count": 12,
  "groups": [
    "identity",
    "quantity",
    "coffee",
    "origin",
    "packaging"
  ],
  "attributes": {
    "identity.name": {
      "type": "string",
      "unit": null,
      "description": "Source-listed coffee product name.",
      "model_role": "identity",
      "standardization_rule": "identity_text",
      "scope": "product"
    },
    "identity.brand": {
      "type": "string",
      "unit": null,
      "description": "Product brand, kept separate from seller identity.",
      "model_role": "predictor",
      "standardization_rule": "identity_text",
      "scope": "product"
    },
    "identity.product_group": {
      "type": "enum",
      "unit": null,
      "description": "Reviewed coffee comparison group.",
      "model_role": "predictor",
      "standardization_rule": "controlled_vocabulary",
      "scope": "product",
      "allowed_values": [
        "whole_bean",
        "ground",
        "instant"
      ]
    },
    "identity.source_role": {
      "type": "enum",
      "unit": null,
      "description": "Selling source role independently of product brand.",
      "model_role": "predictor",
      "standardization_rule": "controlled_vocabulary",
      "scope": "product",
      "allowed_values": [
        "brand",
        "retail"
      ]
    },
    "identity.retailer": {
      "type": "string",
      "unit": null,
      "description": "Selling source name, separate from product brand.",
      "model_role": "predictor",
      "standardization_rule": "identity_text",
      "scope": "product"
    },
    "quantity.net_weight_g": {
      "type": "number",
      "unit": "g",
      "description": "Positive net mass of coffee contents in the selling unit, excluding shipping weight.",
      "model_role": "predictor",
      "standardization_rule": "explicit_net_mass",
      "scope": "product",
      "minimum": 0
    },
    "coffee.roast": {
      "type": "enum",
      "unit": null,
      "description": "Source-declared roast level; no numerical conversion from proprietary roast scales.",
      "model_role": "predictor",
      "standardization_rule": "controlled_vocabulary",
      "scope": "product",
      "allowed_values": [
        "light",
        "medium",
        "dark"
      ]
    },
    "coffee.format": {
      "type": "enum",
      "unit": null,
      "description": "Source-declared coffee form.",
      "model_role": "predictor",
      "standardization_rule": "controlled_vocabulary",
      "scope": "product",
      "allowed_values": [
        "whole_bean",
        "ground",
        "instant"
      ]
    },
    "coffee.decaf_claim": {
      "type": "enum",
      "unit": null,
      "description": "Explicit decaffeinated presence/absence declaration; omission remains unknown.",
      "model_role": "predictor",
      "standardization_rule": "controlled_vocabulary",
      "scope": "product",
      "allowed_values": [
        "present",
        "absent"
      ]
    },
    "coffee.arabica_percentage": {
      "type": "number",
      "unit": "percent",
      "description": "Exact whole-product declared arabica percentage; minimum and blend-component bases remain qualified.",
      "model_role": "predictor",
      "standardization_rule": "bounded_percentage",
      "scope": "product",
      "minimum": 0,
      "maximum": 100
    },
    "origin.countries": {
      "type": "string_list",
      "unit": null,
      "description": "Explicit source-declared coffee growing countries; seller address is not origin.",
      "model_role": "candidate",
      "standardization_rule": "country_labels",
      "scope": "product"
    },
    "packaging.type": {
      "type": "enum",
      "unit": null,
      "description": "Explicit physical package type; unreadable packaging remains unknown.",
      "model_role": "candidate",
      "standardization_rule": "controlled_vocabulary",
      "scope": "product",
      "allowed_values": [
        "bag",
        "tin",
        "jar",
        "capsule_box",
        "other"
      ]
    }
  },
  "purpose": "Demonstrate category-specific processing without chocolate attributes or a fitted pricing model.",
  "category_boundaries": {
    "included": [
      "Packaged whole-bean coffee",
      "Packaged ground coffee",
      "Packaged instant coffee"
    ],
    "excluded": [
      "Ready-to-drink coffee",
      "Cafeteria drinks",
      "Mixed gift bundles without separately observed coffee mass"
    ]
  },
  "comparison_basis": {
    "currency": "GBP",
    "unit": "GBP_per_100g",
    "quantity_attribute": "quantity.net_weight_g",
    "base_quantity": 100
  },
  "missing_values": {
    "known": "Evidence-supported canonical value.",
    "unknown": "Unavailable or not established; never zero or absence.",
    "conflict": "Contradictory evidence with no selected value.",
    "not_applicable": "Evidence-backed decision that the field does not apply."
  }
}
