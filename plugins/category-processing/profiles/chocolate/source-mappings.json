  "safety_rules": {
    "match": "Apply whole semantic label/claim in a product-specific section; an alias is not a license for substring or footer matching.",
    "absence": "No statement, missing ingredient section, empty source tag list, or unknown alias never means absent. Negated claims require explicit contextual negation.",
    "scope": "Conditional vegan when prepared with plant milk, organic ingredient, brand B Corp and component FSC/recyclability claims retain different scope and qualifier; model indicators require supported unconditional scope.",
    "fairtrade": "Generic fair trade/fair-trade and direct trade never establish named Fairtrade certification; navigation or comparison mentions do not establish any claim.",
    "shipping": "Never classify Shopify grams or shipping/gross weight as edible/net mass.",
    "contradictions": "Do not average or overwrite contradictory source statements; retain conflict and all evidence.",
    "unmapped": "Preserve unrecognized raw claims/labels with capture pointer; add reviewed mappings and bump mapping/schema version when semantics change.",
    "image": "Retained images are evidence; image-derived interpretations require explicit method and review, never an unstated deterministic mapping."
  }
}
